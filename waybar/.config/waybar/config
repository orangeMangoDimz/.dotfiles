{
    "layer": "top",
    "position": "top",
    "start_hidden": true,
    "margin-top": 8,
    "margin-bottom": 8,
    "margin-left": 12,
    "margin-right": 12,
    "include": [
        "$HOME/.config/waybar/Modules",
        "$HOME/.config/waybar/ModulesWorkspaces",
        "$HOME/.config/waybar/ModulesCustom",
        "$HOME/.config/waybar/ModulesGroups",
        "$HOME/.config/waybar/UserModules"
    ],
    "modules-left": [
        "hyprland/workspaces#pacman"
    ],
    "modules-center": [
        "custom/media-prev",
        "custom/media-toggle",
        "custom/media-title",
        "custom/media-next",
        "custom/media-mute",
        "custom/cava_mviz"
    ],
    "modules-right": [
        "clock",
        "battery",
        "temperature",
        "custom/separator#dot-line",
        "tray"
    ],
    "custom/media-prev": {
        "format": "󰒮",
        "exec": "printf 1",
        "exec-if": "playerctl metadata --format='{{title}}' >/dev/null 2>&1",
        "interval": 2,
        "on-click": "playerctl previous",
        "tooltip": true,
        "tooltip-format": "Previous track"
    },
    "custom/media-toggle": {
        "format": "{text}",
        "return-type": "json",
        "exec": "media_status=$(playerctl status 2>/dev/null) || exit 1; case \"$media_status\" in Playing) printf '{\"text\":\"\",\"tooltip\":\"Playing — click to pause\",\"class\":\"playing\"}' ;; Paused) printf '{\"text\":\"\",\"tooltip\":\"Paused — click to play\",\"class\":\"paused\"}' ;; *) printf '{\"text\":\"\",\"tooltip\":\"Stopped — click to play\",\"class\":\"stopped\"}' ;; esac",
        "exec-if": "playerctl metadata --format='{{title}}' >/dev/null 2>&1",
        "interval": 1,
        "on-click": "playerctl play-pause",
        "tooltip": true
    },
    "custom/media-next": {
        "format": "󰒭",
        "exec": "printf 1",
        "exec-if": "playerctl metadata --format='{{title}}' >/dev/null 2>&1",
        "interval": 2,
        "on-click": "playerctl next",
        "tooltip": true,
        "tooltip-format": "Next track"
    },
    "custom/media-mute": {
        "format": "{text}",
        "return-type": "json",
        "exec": "mute=$(pamixer --get-mute 2>/dev/null) || exit 1; volume=$(pamixer --get-volume 2>/dev/null) || exit 1; if [ \"$mute\" = \"true\" ]; then printf '{\"text\":\"󰖁\",\"alt\":\"muted\",\"class\":\"muted\",\"tooltip\":\"Muted — click to unmute\"}'; elif [ \"$volume\" -eq 0 ]; then printf '{\"text\":\"󰖁\",\"alt\":\"silent\",\"class\":\"silent\",\"tooltip\":\"Volume: 0%% — click to toggle mute\"}'; elif [ \"$volume\" -le 30 ]; then printf '{\"text\":\"\",\"alt\":\"low\",\"class\":\"low\",\"tooltip\":\"Volume: %s%% — click to mute\"}' \"$volume\"; elif [ \"$volume\" -le 60 ]; then printf '{\"text\":\"\",\"alt\":\"medium\",\"class\":\"medium\",\"tooltip\":\"Volume: %s%% — click to mute\"}' \"$volume\"; else printf '{\"text\":\"󰕾\",\"alt\":\"high\",\"class\":\"high\",\"tooltip\":\"Volume: %s%% — click to mute\"}' \"$volume\"; fi",
        "exec-if": "playerctl metadata --format='{{title}}' >/dev/null 2>&1",
        "interval": 2,
        "on-click": "$HOME/.config/hypr/scripts/Volume.sh --toggle",
        "tooltip": true
    },
    "custom/media-title": {
        "format": "{text}",
        "return-type": "json",
        "max-length": 40,
        "exec": "playerctl metadata --format='{\"text\":\"{{artist}}  {{markup_escape(title)}}\",\"tooltip\":\"{{playerName}}: {{markup_escape(title)}}\",\"alt\":\"{{status}}\",\"class\":\"{{status}}\"}' 2>/dev/null || printf '%s' '{\"text\":\"What'\"'\"'s Up?\",\"tooltip\":\"No music playing\",\"alt\":\"empty\",\"class\":\"empty\"}'",
        "on-click": "playerctl play-pause",
        "interval": 2
    },
    "custom/music": {
        "format": "  {}",
        "escape": true,
        "interval": 5,
        "tooltip": false,
        "exec": "playerctl metadata --format='{{ title }}'",
        "on-click": "playerctl play-pause",
        "max-length": 25
    },
    "clock": {
        "interval": 60,
        "timezone": "Asia/Jakarta",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": " {:%H:%M}"
    }
}
