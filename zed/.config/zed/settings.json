// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "button": false,
    "dock": "left",
  },
  "outline_panel": {
    "button": false,
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "agent": {
    "button": false,
    "dock": "right",
    "default_width": 350,
    "expand_edit_card": false,
    "expand_terminal_card": false,
    "thinking_display": "always_collapsed",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "button": false,
    "dock": "left",
  },
  "vim_mode": true,
  "terminal": {
    "font_family": "Fira Code",
    "font_weight": 600,
    "font_size": 20,
    "blinking": "off",
    "button": false,
  },
  "icon_theme": "Catppuccin Mocha",
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "mode": "agent-full-access",
        "fast-mode": true,
        "model": "gpt-5.6-terra"
      },
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "effort": "max",
        "model": "sonnet",
        "mode": "bypassPermissions",
      },
      "type": "registry",
    },
  },
  "tab_bar": { "show": false },
  "toolbar": { "breadcrumbs": true },
  "status_bar": {
    "experimental.show": true,
    "active_language_button": false,
    "cursor_position_button": true,
    "line_endings_button": false,
  },
  "search": {
    "button": false,
  },
  "diagnostics": {
    "button": false,
    "include_warnings": false,
    "inline": {
      "enabled": false,
    },
  },
  "diagnostics_max_severity": "error",
  "global_lsp_settings": {
    "button": false,
  },
  "debugger": {
    "button": false,
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "scrollbar": {
    "show": "never",
  },
  "show_wrap_guides": true,
  "wrap_guides": [80],
  "base_keymap": "VSCode",
  "ui_font_size": 24,
  "ui_font_weight": 600,
  "buffer_font_size": 20,
  "buffer_font_weight": 600,
  "agent_ui_font_size": 26,
  "agent_buffer_font_size": 22,
  "relative_line_numbers": "enabled",
  "cursor_blink": false,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Catppuccin Mocha",
  },
}
