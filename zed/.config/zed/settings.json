// Zed settings
//
// Docs: https://zed.dev/docs/configuring-zed
// Defaults: run `zed: open default settings`
{
  // Window and panels
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "auto_fold_dirs": false,
    "button": false,
    "dock": "left",
    "default_width": 280,
    "entry_spacing": "comfortable",
    "hide_root": false,
    "indent_size": 20,
    "indent_guides": {
      "show": "never",
    },
  },
  "outline_panel": {
    "button": false,
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "git_panel": {
    "button": false,
    "dock": "left",
  },
  "tab_bar": {
    "show": false,
  },
  "toolbar": {
    "breadcrumbs": true,
  },
  "status_bar": {
    "experimental.show": true,
    "active_language_button": false,
    "cursor_position_button": true,
    "line_endings_button": false,
  },
  "search": {
    "button": false,
  },
  "scrollbar": {
    "show": "never",
  },

  // Agent panel
  "agent": {
    "button": false,
    "dock": "right",
    "sidebar_side": "right",
    "flexible": false,
    "default_width": 350,
    "limit_content_width": false,
    "notify_when_agent_waiting": "never",
    "play_sound_when_agent_done": "when_hidden",
    "expand_edit_card": false,
    "expand_terminal_card": false,
    "thinking_display": "always_collapsed",
    "favorite_models": [],
    "model_parameters": [],
  },

  // Agent providers
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "xhigh",
        "collaboration_mode": "plan",
        "mode": "agent-full-access",
        "fast-mode": true,
        "model": "gpt-5.6-sol",
      },
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "effort": "max",
        "model": "sonnet",
        "mode": "bypassPermissions",
      },
      "type": "registry",
    },
  },

  // Editor behavior
  "vim_mode": true,
  "base_keymap": "VSCode",
  "relative_line_numbers": "enabled",
  "cursor_blink": false,

  // Terminal
  "terminal": {
    "font_family": "Fira Code",
    "font_weight": 600,
    "font_size": 20,
    "blinking": "off",
    "button": false,
    "bell": "system",
    "flexible": false,
  },

  // Appearance
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha",
  },
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Ayu Darker",
  },

  // Top bars and guides
  "show_wrap_guides": true,
  "wrap_guides": [80],

  // Diagnostics and language tools
  "diagnostics": {
    "button": false,
    "include_warnings": false,
    "inline": {
      "enabled": false,
    },
  },
  "diagnostics_max_severity": "error",
  "global_lsp_settings": {
    "button": false,
  },
  "debugger": {
    "button": false,
  },

  // Git
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },

  // Font sizes and weights
  "ui_font_size": 24,
  "ui_font_weight": 600,
  "buffer_font_size": 20,
  "buffer_font_weight": 600,
  "agent_ui_font_size": 26,
  "agent_buffer_font_size": 22,

  // Panel resizing
  "resize_all_panels_in_dock": [],
}
