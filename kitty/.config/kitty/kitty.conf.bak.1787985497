startup_mode windowed
hide_window_decorations yes
font_family Fira Code SemiBold
font_size 14.0
bold_font auto
italic_font auto
bold_italic_font auto
adjust_line_height 120%
# modify_font cell_height 125%

# transparency now handled by Hyprland (window opacity + blur), not kitty
# old: 0.65 unreadable, 0.9 stacked w/ Hyprland. 1.0 = kitty opaque, Hyprland glasses it
background_opacity 1.0
confirm_os_window_close 0

# change to x11 or wayland or leave auto
linux_display_server auto

scrollback_lines 2000
wheel_scroll_min_lines 1

enable_audio_bell no

# window_padding_width 0 32 0 32
window_padding_width 0

selection_foreground none
selection_background none

allow_remote_control yes

map ctrl+shift+up    resize_window taller
map ctrl+shift+down  resize_window shorter
map shift+enter      send_text all \x1b[13;2u

# Ayu Dark theme
# The basic colors
foreground #e5e1cf
background #0e1419
selection_foreground    #0e1419
selection_background    #243340

# Cursor colors
cursor #f19618
cursor_text_color       #0e1419
cursor_shape            block
shell_integration       no-cursor

# URL underline color when hovering with mouse
url_color               #68d4ff

# Kitty window border colors
active_border_color     #e6c446
inactive_border_color   #323232
bell_border_color       #ff6565

# OS Window titlebar colors
wayland_titlebar_color system
macos_titlebar_color system

# Tab bar colors
active_tab_foreground   #eeeeee
active_tab_background   #243340
inactive_tab_foreground #e5e1cf
inactive_tab_background #0b1014
tab_bar_background      #0b1014

# Colors for marks (marked text in the terminal)
mark1_foreground #0e1419
mark1_background #e6c446
mark2_foreground #0e1419
mark2_background #f07078
mark3_foreground #0e1419
mark3_background #95e5cb

# The 16 terminal colors

# black
color0 #000000
color8 #323232

# red
color1 #ff3333
color9 #ff6565

# green
color2  #b8cc52
color10 #e9fe83

# yellow
color3  #e6c446
color11 #fff778

# blue
color4  #36a3d9
color12 #68d4ff

# magenta
color5  #f07078
color13 #ffa3aa

# cyan
color6  #95e5cb
color14 #c7fffc

# white
color7  #ffffff
color15 #ffffff

# Optional: uncomment to switch back to Catppuccin Mocha.
# include kitty-themes/catppuccin-mocha.conf
